{
  "name": "gazu-store-2",
  "version": "1.0.0",
  "description": "GAZU MERN fashion store: CE-2 and ETE implementation",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "concurrently -k -n BACKEND,FRONTEND,PAYMENTS \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\" \"npm run start --prefix payment-service\"",
    "build": "npm run build --prefix frontend",
    "test": "npm test --prefix backend && npm test --prefix frontend && npm test --prefix payment-service",
    "setup": "npm ci --prefix backend && npm ci --prefix frontend && npm ci --prefix payment-service",
    "env:check": "node scripts/check-root-env.mjs",
    "catalogue:three": "node backend/scripts/keepOnlyThree.js",
    "catalogue:footwear": "node backend/scripts/addFootwear.js",
    "catalogue:mens-clothing": "node backend/scripts/addMensClothing.js",
    "catalogue:mens-final": "node backend/scripts/addMensFinal.js",
    "test:hero": "node --test scripts/editorial-hero.test.mjs",
    "test:brand-intro": "node --test scripts/brand-intro.test.mjs",
    "test:cinematic-hero": "node --test scripts/cinematic-hero.test.mjs",
    "test:summer": "node --test scripts/this-summer.test.mjs",
    "test:dress-like": "node --test scripts/dress-like.test.mjs",
    "test:editorial-categories": "node --test scripts/phase5-editorial-categories.test.mjs",
    "test:liquid-nav": "node --test scripts/liquid-navbar.test.mjs",
    "test:liquid-utilities": "node --test scripts/liquid-utilities.test.mjs",
    "test:sitewide-liquid": "node --test scripts/sitewide-liquid-nav.test.mjs",
    "test:product-shelf": "node --test scripts/product-shelf.test.mjs",
    "test:shelf-footer": "node --test scripts/shelf-footer-motion.test.mjs",
    "test:phases:unit": "node --test backend/tests/workstreams/*.test.mjs frontend/src/tests/workstreams/*.test.mjs",
    "test:phases:smoke": "node --test scripts/phase7-12-http-smoke.mjs",
    "test:editorial-expansion": "node --test scripts/editorial-expansion.test.mjs",
    "test:session": "npm run test:session --prefix frontend",
    "ai:audit": "npm run ai:audit --prefix backend --",
    "ai:worker": "npm run ai:worker --prefix backend",
    "ai:index": "npm run ai:index --prefix backend --",
    "test:wave1": "npm run test:wave1 --prefix backend",
    "ai:enqueue:all": "npm run ai:enqueue:all --prefix backend --",
    "ai:staging:status": "node backend/scripts/aiStaging.js status",
    "ai:staging:semantic": "node backend/scripts/aiStaging.js semantic",
    "ai:staging:queue-tags": "node backend/scripts/aiStaging.js queue-tags --confirm",
    "ai:staging:worker": "node backend/scripts/aiStaging.js worker",
    "wave2:staging": "node --env-file=.env scripts/launchWave2Staging.mjs",
    "test:wave2": "node --test backend/tests/wave2/agent*.test.js",
    "test:wave2:http": "npm run test:wave2:http --prefix backend",
    "test:wave2:browser": "node scripts/runWave2BrowserTests.mjs",
    "wave3:staging": "node --env-file=.env scripts/launchWave3Staging.mjs",
    "test:wave3": "node --test backend/tests/wave3/agent*.unit.test.js",
    "test:wave3:http": "npm run test:wave3:http --prefix backend",
    "test:wave3:browser": "node scripts/runWave3BrowserTests.mjs",
    "test:no-recent-view": "node --test scripts/no-recently-viewed.test.mjs",
    "test:architecture": "node --test scripts/architecture-refactor.test.mjs",
    "verify:refactor": "npm run test:architecture && npm run test:wave2 && npm run test:wave3 && npm run test:no-recent-view",
    "https:setup": "node scripts/setupLocalHttps.mjs",
    "dev:https": "node --env-file=.env scripts/launchHttps.mjs",
    "wave3:staging:https": "node --env-file=.env scripts/launchHttps.mjs --staging",
    "test:https": "node --test scripts/https-config.test.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10"
  }
}
