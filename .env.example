# Copy to the repository root as .env and supply your own local credentials.
# Do not commit .env or put server secrets in VITE_ variables.

NODE_ENV=development
PORT=8000
FRONTEND_PORT=5173
API_PROXY_TARGET=
VITE_API_URL=/api
VITE_GOOGLE_CLIENT_ID=
CLIENT_ORIGIN=http://localhost:5173

GAZU_DB_MODE=atlas
MONGODB_URI=
MONGODB_STAGING_URI=
JWT_SECRET=
OTP_SECRET=

REDIS_URL=
CACHE_ENABLED=true
CACHE_TTL_SECONDS=30
LOG_LEVEL=info
UPLOAD_DIR=./data/uploads

PAYMENT_SERVICE_URL=http://127.0.0.1:4001
PAYMENT_SERVICE_SECRET=
PAYMENT_SERVICE_PORT=4001
PAYMENT_TIMEOUT_MS=5000
ENABLE_MOCK_PAYMENTS=true
PAYMENT_JOURNAL_PATH=./data/decisions.json

EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
TEST_EMAIL_TO=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

ADMIN_NAME=GAZU Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

GAZU_AI_PROVIDER=mock
GAZU_AI_ALLOW_MOCK_CHAT=false
GAZU_AI_MODEL=
GEMINI_API_KEY=
GAZU_AI_EMBEDDING_MODEL=
GAZU_AI_VECTOR_ENABLED=false
GAZU_AI_AUTO_INDEX=false
GAZU_AI_AUDIT_ALLOW_DATABASE=false
GAZU_AI_PUBLIC_DAILY_REQUESTS=300
GAZU_AI_USER_DAILY_REQUESTS=30
GAZU_AI_USER_DAILY_TOKENS=60000

GAZU_WEB_PORT=8080
GAZU_HTTPS_ENABLED=false
GAZU_TLS_KEY_FILE=
GAZU_TLS_CERT_FILE=
