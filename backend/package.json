{
  "name": "gazu-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed.js",
    "test": "node --test tests/*.test.js",
    "test:unit": "node --test tests/validation.test.js",
    "test:email": "node src/testEmail.js",
    "ai:audit": "node scripts/aiCatalogueAudit.js",
    "ai:index": "node scripts/aiAtlasIndex.js",
    "ai:worker": "node src/workers/aiWorker.js",
    "test:wave1": "node --test tests/wave1/*.test.js",
    "ai:enqueue:all": "node scripts/aiEnqueueAll.js",
    "test:wave2": "node --test tests/wave2/agent*.test.js",
    "test:wave2:http": "node --test tests/wave2/http.test.js",
    "test:wave3": "node --test tests/wave3/agent*.unit.test.js",
    "test:wave3:http": "node --test tests/wave3/http.integration.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "google-auth-library": "^11.3.3",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.1",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "redis": "^6.3.1",
    "winston": "^3.19.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.2.3",
    "supertest": "^7.1.4"
  }
}
